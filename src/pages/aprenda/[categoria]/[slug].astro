---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { CATEGORIES, SITE } from '../../../consts';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../../lib/seo';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos');
  return artigos.map((a) => ({
    params: { categoria: a.data.category, slug: a.id },
    props: { artigo: a },
  }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);

const catName =
  CATEGORIES.find((c) => c.slug === artigo.data.category)?.name ??
  artigo.data.category;
const url = `/aprenda/${artigo.data.category}/${artigo.id}/`;
const image = new URL(SITE.ogImage, SITE.url).href;

const crumbs = [
  { name: 'Início', url: '/' },
  { name: 'Aprenda', url: '/aprenda/' },
  { name: catName, url: `/aprenda/${artigo.data.category}/` },
  { name: artigo.data.title, url },
];

const schema = [
  articleSchema({
    title: artigo.data.title,
    description: artigo.data.description,
    url: new URL(url, SITE.url).href,
    image,
    publishedAt: artigo.data.publishedAt.toISOString(),
    updatedAt: artigo.data.updatedAt?.toISOString(),
    author: artigo.data.author,
  }),
  breadcrumbSchema(crumbs),
];

if (artigo.data.faq?.length) {
  schema.push(faqSchema(artigo.data.faq));
}
---

<BaseLayout
  title={artigo.data.title}
  description={artigo.data.description}
  type="article"
  canonical={url}
  schema={schema}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <article class="prose">
      <h1>{artigo.data.title}</h1>
      <p class="article-meta">
        Por {artigo.data.author} · Atualizado em{' '}
        {(artigo.data.updatedAt ?? artigo.data.publishedAt).toLocaleDateString('pt-BR')}
      </p>
      <Content />
    </article>
  </div>
</BaseLayout>
