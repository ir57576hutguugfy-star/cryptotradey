---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../../lib/seo';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Corretoras', path: '/corretoras/' },
  { name: 'Melhores corretoras', path: '/corretoras/melhores-corretoras/' },
];
---

<BaseLayout
  title="Melhor corretora de criptomoedas no Brasil"
  description="Ranking das melhores corretoras de criptomoedas para brasileiros, com comparativo de taxas, segurança e suporte."
  canonical="/corretoras/melhores-corretoras/"
  schema={[breadcrumbSchema(crumbs)]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1>Melhor corretora de criptomoedas no Brasil</h1>
    <p class="lead">
      Comparativo das principais exchanges para você decidir com segurança.
    </p>

    <div class="empty">
      Ranking em breve. Estamos preparando o comparativo completo.
    </div>
  </div>
</BaseLayout>
