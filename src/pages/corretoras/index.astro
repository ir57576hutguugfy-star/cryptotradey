---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../../lib/seo';
import { toBase } from '../../lib/url';
import { getCollection } from 'astro:content';

const corretoras = (await getCollection('corretoras')).sort(
  (a, b) => b.data.rating - a.data.rating
);

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Corretoras', path: '/corretoras/' },
];
---

<BaseLayout
  title="Melhores corretoras de criptomoedas"
  description="Reviews e comparativos das principais corretoras de criptomoedas para brasileiros."
  canonical="/corretoras/"
  schema={[breadcrumbSchema(crumbs)]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1>Corretoras de criptomoedas</h1>
    <p class="lead">
      Análises honestas para você escolher onde comprar e vender criptomoedas.
    </p>

    <a class="btn btn--primary" href={toBase('/corretoras/melhores-corretoras/')}>
      Ver ranking das melhores corretoras
    </a>

    {corretoras.length === 0 ? (
      <div class="empty">Reviews em breve.</div>
    ) : (
      <div class="card-grid">
        {corretoras.map((c) => (
          <a class="card" href={toBase(`/corretoras/${c.id}/`)}>
            <h3>{c.data.exchangeName}</h3>
            <p>{c.data.verdict}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
