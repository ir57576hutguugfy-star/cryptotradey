---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { toBase } from '../lib/url';
---

<BaseLayout title={SITE.title} description={SITE.description} canonical="/">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Educação cripto gratuita</span>
      <h1>Criptomoedas explicadas de forma <span class="grad">simples</span></h1>
      <p class="lead">
        Artigos e glossário para brasileiros entenderem criptomoedas de
        forma simples e segura.
      </p>
      <div class="hero-features">
        <span class="hero-feature"><span class="dot"></span>Explicações diretas</span>
        <span class="hero-feature"><span class="dot"></span>Sem jargão</span>
        <span class="hero-feature"><span class="dot"></span>Atualizado regularmente</span>
      </div>
      <div class="hero-actions">
        <a class="btn btn--primary" href={toBase('/artigos/')}>Explorar artigos →</a>
        <a class="btn btn--ghost" href={toBase('/glossario/')}>Ver glossário</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Conteúdo</span>
        <h2>O que você encontra aqui</h2>
      </div>
      <div class="card-grid">
        <a class="card" href={toBase('/artigos/')}>
          <span class="card-icon">📝</span>
          <h3>Artigos</h3>
          <p>Conteúdos e análises sobre o universo cripto.</p>
          <span class="card-arrow">Explorar →</span>
        </a>
        <a class="card" href={toBase('/glossario/')}>
          <span class="card-icon">📖</span>
          <h3>Glossário</h3>
          <p>Termos e conceitos do universo cripto explicados de forma simples.</p>
          <span class="card-arrow">Explorar →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
