---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../consts';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';
import { toAbs } from '../../lib/url';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos');
  return artigos.map((a) => ({
    params: { slug: a.id },
    props: { artigo: a },
  }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);

const url = `/artigos/${artigo.id}/`;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Artigos', path: '/artigos/' },
  { name: artigo.data.title, path: url },
];

const schema = [
  articleSchema({
    title: artigo.data.title,
    description: artigo.data.description,
    url: toAbs(url),
    image: toAbs(SITE.ogImage),
    publishedAt: artigo.data.publishedAt.toISOString(),
    updatedAt: artigo.data.updatedAt?.toISOString(),
    author: artigo.data.author,
  }),
  breadcrumbSchema(crumbs),
];

if (artigo.data.faq?.length) {
  schema.push(faqSchema(artigo.data.faq));
}
---

<BaseLayout
  title={artigo.data.title}
  description={artigo.data.description}
  type="article"
  canonical={url}
  schema={schema}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <article class="prose">
      <h1>{artigo.data.title}</h1>
      <p class="article-meta">
        Por {artigo.data.author} ·{' '}
        {(artigo.data.updatedAt ?? artigo.data.publishedAt).toLocaleDateString('pt-BR')}
      </p>
      <Content />
    </article>
  </div>
</BaseLayout>
