---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../consts';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';
import { toAbs } from '../../lib/url';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const comparacoes = await getCollection('comparacoes');
  return comparacoes.map((c) => ({
    params: { slug: c.id },
    props: { comparacao: c },
  }));
}

const { comparacao } = Astro.props;
const { Content } = await render(comparacao);

const url = `/comparacoes/${comparacao.id}/`;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Comparações', path: '/comparacoes/' },
  { name: comparacao.data.title, path: url },
];

const schema = [
  articleSchema({
    title: comparacao.data.title,
    description: comparacao.data.description,
    url: toAbs(url),
    image: toAbs(SITE.ogImage),
    publishedAt: comparacao.data.publishedAt.toISOString(),
    updatedAt: comparacao.data.updatedAt?.toISOString(),
    author: comparacao.data.author,
  }),
  breadcrumbSchema(crumbs),
];

if (comparacao.data.faq?.length) {
  schema.push(faqSchema(comparacao.data.faq));
}
---

<BaseLayout
  title={comparacao.data.title}
  description={comparacao.data.description}
  type="article"
  canonical={url}
  schema={schema}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <article class="prose">
      <h1>{comparacao.data.title}</h1>
      <p class="article-meta">
        Por {comparacao.data.author} ·{' '}
        {(comparacao.data.updatedAt ?? comparacao.data.publishedAt).toLocaleDateString('pt-BR')}
      </p>
      <Content />
    </article>
  </div>
</BaseLayout>
