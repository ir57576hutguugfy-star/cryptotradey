---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../lib/seo';

const crumbs = [
  { name: 'Início', url: '/' },
  { name: 'Comparações', url: '/comparacoes/' },
];
---

<BaseLayout
  title="Comparações de corretoras e criptomoedas"
  description="Comparativos lado a lado: Binance vs Mercado Bitcoin, Bitcoin vs Ethereum e mais."
  schema={[breadcrumbSchema(crumbs)]}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1>Comparações</h1>
    <p class="lead">Comparativos lado a lado para facilitar sua decisão.</p>

    <div class="empty">Comparações em breve.</div>
  </div>
</BaseLayout>
