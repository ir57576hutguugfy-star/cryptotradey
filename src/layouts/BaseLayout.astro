---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organizationSchema, websiteSchema, type JsonLd } from '../lib/seo';
import { toBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: JsonLd[];
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;

const baseSchema: JsonLd[] = [organizationSchema(), websiteSchema()];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={toBase('/favicon.svg')} />
    <link rel="sitemap" href={toBase('/sitemap-index.xml')} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      schema={[...baseSchema, ...schema]}
    />
  </head>
  <body>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
