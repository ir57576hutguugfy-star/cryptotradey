---
import { NAV_LINKS, SITE } from '../consts';
import { toBase } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={toBase('/')} class="logo logo--footer">
          <span class="logo-mark" aria-hidden="true">₿</span>
          <span class="logo-text">{SITE.title}</span>
        </a>
        <p class="footer-tagline">{SITE.tagline}</p>
      </div>

      <nav class="footer-col" aria-label="Navegação do rodapé">
        {NAV_LINKS.map((link) => (
          <a href={toBase(link.href)} class="footer-link">{link.label}</a>
        ))}
        <a href={toBase('/sobre/')} class="footer-link">Sobre nós</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclaimer">
        <strong>Aviso:</strong> este site tem caráter educacional e não é uma
        recomendação de investimento. Alguns links são de afiliados e podem
        gerar comissão sem custo adicional para você.
      </p>
      <p class="footer-copy">
        © {year} {SITE.title}. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>
