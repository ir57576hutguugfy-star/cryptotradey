---
import type { Crumb } from '../lib/seo';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Trilha de navegação">
  <ol>
    {items.map((item, i) => (
      <li>
        {i === items.length - 1 ? (
          <span aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url}>{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
